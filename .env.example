# Copy this file to .env and fill it in. .env is git-ignored.

# Claude writes the replies when this is set. Without it the bot still answers,
# with a fixed acknowledgement message.
ANTHROPIC_API_KEY=

# Model used for replies.
# ANTHROPIC_MODEL=claude-opus-5-5

# Your name as LinkedIn shows it. Leave empty to let the bot read it from the page.
# OWNER_NAME=

# Seconds between polls.
# POLL_SECONDS=20

# true = look and log only: nothing is accepted, nothing is sent.
# DRY_RUN=false

# true = the first reply in a conversation says it is automated.
# DISCLOSE_AUTOMATION=true

# Safety limits.
# MAX_REPLIES_PER_HOUR=40
# MAX_REPLIES_PER_THREAD_PER_HOUR=12

# Only needed when LinkedIn's interface is not in English or French.
# ACCEPT_WORDS=Accept,Accepter
# SELF_PREFIXES=You:,Vous :
